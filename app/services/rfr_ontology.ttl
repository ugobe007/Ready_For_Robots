<https://readyforrobots.com/ontology>
    a owl:Ontology ;
    rdfs:label "Ready for Robots — Buyer Intent Ontology" ;
    rdfs:comment "Auto-exported from app/services/ontology.py" .

rfr:Concept       a owl:Class ; rdfs:label "Concept" .
rfr:InferenceRule a owl:Class ; rdfs:label "InferenceRule" .
rfr:Industry      a owl:Class ; rdfs:label "Industry" .

rfr:implies       a owl:ObjectProperty .
rfr:relatedTo     a owl:ObjectProperty .
rfr:hasCondition  a owl:ObjectProperty .
rfr:concludes     a owl:ObjectProperty .
rfr:domain        a owl:DatatypeProperty ; rdfs:range xsd:string .
rfr:baseWeight    a owl:DatatypeProperty ; rdfs:range xsd:float .
rfr:boost         a owl:DatatypeProperty ; rdfs:range xsd:float .
rfr:prior         a owl:DatatypeProperty ; rdfs:range xsd:float .

