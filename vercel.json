{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile -C readyforrobots-new",
  "buildCommand": "cd readyforrobots-new && VITE_PUBLIC_API_URL=https://ready-2-robot.fly.dev npx --yes pnpm@10.4.1 exec vite build",
  "outputDirectory": "readyforrobots-new/dist/public",
  "framework": null,
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
