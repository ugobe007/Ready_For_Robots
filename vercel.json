{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile -C readyforrobots-new",
  "buildCommand": "cd readyforrobots-new && VITE_PUBLIC_API_URL= npx --yes pnpm@10.4.1 exec vite build",
  "outputDirectory": "readyforrobots-new/dist/public",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] || case \"$VERCEL_GIT_COMMIT_REF\" in cursor/*) true;; *) false;; esac",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ready-2-robot.fly.dev/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://ready-2-robot.fly.dev/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ready-2-robot.fly.dev/health"
    },
    {
      "source": "/privacy",
      "destination": "/privacy.html"
    },
    {
      "source": "/terms",
      "destination": "/terms.html"
    },
    {
      "source": "/support",
      "destination": "/support.html"
    },
    {
      "source": "/((?!robots\\.txt$|sitemap\\.xml$|privacy/?$|terms/?$|support/?$|legal/).*)",
      "destination": "/index.html"
    }
  ]
}
