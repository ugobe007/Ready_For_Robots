# Example environment variable configuration for the Ready for Robots project

# ── Naming (do not confuse these) ───────────────────────────────────────────
# SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co  (REST + Auth base URL for JWKS — NOT postgres)
# DATABASE_URL = postgresql://...  (SQLAlchemy / psycopg2 — paste pooler or direct URI here)
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SERVICE_KEY = service_role JWT (admin API; optional)
# NEXT_PUBLIC_* = browser-exposed; keep secrets out of NEXT_PUBLIC_*

# ── Supabase Postgres (FastAPI / SQLAlchemy) ───────────────────────────────
# Set EXACTLY ONE DATABASE_URL in this file. Duplicate lines overwrite each other
# (last wins) and often leave you on a template URL — wrong counts / SQLite fallback.
#
# Supabase → Project Settings → Database:
#   - Copy "Connection string" → URI, or build the direct URL below.
#   - Use the current database password (reset it if you do not have it).
#
# Direct (port 5432) — OK for local dev; on Fly.io / many clouds you often get "connection refused"
# (use the pooler below for production).
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Pooler — REQUIRED for Fly.io (`fly secrets set DATABASE_URL=...`):
#   - Transaction mode (port 6543) — higher concurrent client limit; preferred for busy APIs.
#   - Session mode (port 5432, same pooler host) — valid if you prefer it; set SUPABASE_SESSION_POOLER=1
#     to silence the startup note in app/database.py.
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# SUPABASE_SESSION_POOLER=1
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Local dev fallback (SQLite) ────────────────────────────────────────────
# DATABASE_URL=sqlite:///./ready_for_robots.db

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API configuration
API_KEY=your_api_key_here

# Other configurations
DEBUG=True
SECRET_KEY=your_secret_key_here

# Admin access — comma-separated emails with access to /admin panel
ADMIN_EMAILS=ugobe07@gmail.com

# When set, forcing newsletter regen (GET /api/newsletter/edition?refresh=true or POST
# /api/newsletter/generate) requires header X-Newsletter-Regen-Key: <this value>, or an admin JWT.
# Leave unset for local dev (regen stays open).
# NEWSLETTER_REGEN_SECRET=long-random-string

# Static Next export: set at build time so the browser calls your API host
# NEXT_PUBLIC_API_URL=https://your-api.example.com
# NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# FastAPI CORS — comma-separated; required when the static site and API are on different hosts
# (wildcard + credentials is invalid in browsers). Defaults are set in app/main.py if unset.
# CORS_ORIGINS=https://readyforrobots.com,https://ready-2-robot.fly.dev

# Optional: stricter company-name validation for scraped leads (calls wikidata.org for
# long headline-like strings only). Default off — set to 1 in production if desired.
# COMPANY_NAME_WIKIDATA_VERIFY=1

# Optional: infer brand.com / www.brand.com from the first non-generic token and check
# DNS (and HTTPS). Same long-name trigger as Wikidata. Strict reject is off by default.
# COMPANY_NAME_DNS_HTTPS_VERIFY=1
# COMPANY_NAME_DNS_HTTPS_STRICT=1

# Add any additional environment variables as needed