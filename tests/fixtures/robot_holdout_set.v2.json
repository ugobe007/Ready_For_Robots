{
  "name": "RFR robot classification HOLD-OUT set v2",
  "version": "holdout-v2",
  "date": "2026-10-13",
  "taxonomy": "taxonomy.v1.json (v1.1)",
  "purpose": "Fresh robots for measuring evidence-check v2, page-type detection, and the output-limit fix. Never used for any prompt, rule, or code change.",
  "rules_for_use": [
    "1. Freeze code and record the commit hash BEFORE snapshotting or running.",
    "2. Snapshot with scripts/snapshot_pages.py --render into tests/fixtures/robot_pages_holdout_v2; commit snapshots before running.",
    "3. Same frozen scorer and answer-key format as v1. Run once without the product hint (headline) and once with it.",
    "4. Report robots, gap probes, and negative controls separately, per field, with blanked-field counts and a failure list by ID.",
    "5. Report the page_type the extractor assigned for every entry; robots are expected to be manufacturer_product_page.",
    "6. Dead or wrong URL: report it, fix with --url only if the same company's correct page exists, never substitute a company.",
    "7. No changes to prompt, scorer, rules, or answer key based on these results."
  ],
