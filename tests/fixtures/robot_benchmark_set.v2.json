{
  "name": "RFR robot classification benchmark",
  "version": "v2-taxonomy",
  "date": "2026-10-13",
  "taxonomy": "taxonomy.v1.json (v1.1)",
  "purpose": "Answer key in closed taxonomy values. Replaces free-text capability scoring. Every field is scored by exact match against these lists, so the scorer cannot drift with wording.",
  "scoring_rules": {
    "offering_type": "PASS if extracted value is in offering_type_ok",
    "form": "PASS if extracted value is in form_ok",
    "primary_class": "PASS if extracted value is in primary_class_ok (first value is preferred; others are acceptable alternates)",
    "functions": "PASS if every value in functions_required is extracted AND every extracted value is in functions_required or functions_ok",
    "industries": "PASS if every value in industries_required is extracted AND (industries_any is empty OR at least one of industries_any is extracted) AND none of industries_must_not is extracted. Other extra industries are not penalized; industries_ok_extra just lists extras we expect may appear. Industry values were expanded in taxonomy v1.1; where an old broad value split into several new ones, the robot's requirement became 'any of' the new values.",
    "robot_pass": "All five fields PASS",
    "report": "Report per-field accuracy across all robots, not just overall pass/fail. Per-field accuracy shows WHERE an extractor is weak.",
    "product_hint": "Run every robot twice: with product_name passed as a hint and without. Report both. Both extractors get identical treatment.",
    "multi_product_sites": "Score only the record whose product matches target_product. Extracting other products from the same site is fine and not penalized."
  },
