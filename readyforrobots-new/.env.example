# Ready For Robots — Vite frontend (readyforrobots-new/)
#
# Copy to .env.local for local dev:
#   cp .env.example .env.local
#
# Supabase dashboard shows NEXT_PUBLIC_* — this app uses VITE_PUBLIC_* instead.
# Project: https://supabase.com/dashboard/project/lmoyydlhlgdyqbxkmkuz
# Connect → App Frameworks → copy URL + publishable (or anon) key.

# Required for sign-in (Google, GitHub, magic link)
VITE_PUBLIC_SUPABASE_URL=https://lmoyydlhlgdyqbxkmkuz.supabase.co

# Paste ONE key from Supabase → Project Settings → API (lines must NOT start with #)
VITE_PUBLIC_SUPABASE_PUBLISHABLE_KEY=sb_publishable_your_key_here
# VITE_PUBLIC_SUPABASE_ANON_KEY=eyJhbGci...your_anon_jwt_here

# Optional — defaults to Fly in production; local dev uses http://127.0.0.1:8000
# VITE_PUBLIC_API_URL=http://127.0.0.1:8000

# Production builds (Fly Docker / CI) set these in fly.toml [build.args].
# Do not commit real keys in .env.local — it is gitignored.
