# Copy to `.env.local` for local `next dev` / static export builds.
# On Vercel, set the same keys in Project → Settings → Environment Variables (no file commit).

# FastAPI origin the browser calls (no trailing slash). Required for CRM, profile, PDF, etc.
NEXT_PUBLIC_API_URL=https://ready-2-robot.fly.dev

# Supabase Auth (browser). Project: https://<ref>.supabase.co — Dashboard → Settings → API.
NEXT_PUBLIC_SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your_anon_or_publishable_key

# Optional: canonical site URL for links / OG when different from the deployment host.
# NEXT_PUBLIC_SITE_URL=https://readyforrobots.com
