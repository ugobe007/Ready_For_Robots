# Example environment variable configuration for the Ready for Robots project

# ── Naming (do not confuse these) ───────────────────────────────────────────
# SUPABASE_URL = https://YOUR_PROJECT_REF.supabase.co  (REST + Auth base URL for JWKS — NOT postgres)
# DATABASE_URL = postgresql://...  (SQLAlchemy / psycopg2 — paste pooler or direct URI here)
# SUPABASE_SERVICE_ROLE_KEY or SUPABASE_SERVICE_KEY = service_role JWT (admin API; optional)
# NEXT_PUBLIC_* = browser-exposed; keep secrets out of NEXT_PUBLIC_*

# ── Supabase Postgres (FastAPI / SQLAlchemy) ───────────────────────────────
# Authoritative `DATABASE_URL` for Python (API, workers, scripts) should live in
# this repo-root file. `frontend/nextjs/.env.local` is loaded first for Next.js
# keys, then this file overrides — so a wrong or old DATABASE_URL in `.env.local`
# does not break CLI scripts.
# Set EXACTLY ONE DATABASE_URL in this file. Duplicate lines overwrite each other
# (last wins) and often leave you on a template URL — wrong counts / SQLite fallback.
#
# Supabase → Project Settings → Database:
#   - Copy "Connection string" → URI, or build the direct URL below.
#   - Use the current database password (reset it if you do not have it).
#
# Direct (port 5432) — OK for local dev; on Fly.io / many clouds you often get "connection refused"
# (use the pooler below for production).
#   DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres
#
# Pooler — REQUIRED for Fly.io (`fly secrets set DATABASE_URL=...`):
#   - Supabase "Connect" can show several valid shapes; two common ones are:
#     Session: postgres.<ref> @ aws-*-REGION.pooler.supabase.com:5432
#     Transaction: postgres @ db.<ref>.supabase.co:6543  (official docs — not a mistake)
#   - Username must match the selected tab (bare ref alone → Tenant or user not found on pooler).
#   - Transaction mode (port 6543) — higher concurrent client limit; preferred for busy APIs.
#   - Session mode (port 5432, same pooler host) — valid if you prefer it; set SUPABASE_SESSION_POOLER=1
#     to silence the startup note in app/database.py.
#   DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres
#
# SUPABASE_SESSION_POOLER=1
#
DATABASE_URL=postgresql://postgres:YOUR_PASSWORD@db.YOUR_PROJECT_REF.supabase.co:5432/postgres

# ── Local dev fallback (SQLite) ────────────────────────────────────────────
# DATABASE_URL=sqlite:///./ready_for_robots.db

# Redis configuration
REDIS_URL=redis://localhost:6379/0

# Celery configuration
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/0

# API configuration
API_KEY=your_api_key_here

# ── MCP server (third-party AI integrations) ───────────────────────────────
# Mount Streamable HTTP MCP at /mcp on the FastAPI app (Fly production).
# R4R_MCP_ENABLED=1
# R4R_MCP_BEARER_TOKEN=long-random-token-for-partners
# R4R_MCP_PREMIUM=0
# R4R_API_BASE=https://ready-2-robot.fly.dev
# R4R_PARTNER_API_KEY=optional-key-forwarded-as-X-R4R-API-Key
# R4R_API_KEY_PEPPER=long-random-pepper-for-partner-key-hashing
# Standalone: R4R_MCP_TRANSPORT=streamable-http R4R_MCP_PORT=8090 python -m app.mcp
# See mcp/README.md for partner onboarding and tool tiers.

# Other configurations
DEBUG=True
SECRET_KEY=your_secret_key_here

# Admin access — comma-separated emails with access to /admin panel
ADMIN_EMAILS=ugobe07@gmail.com

# Agent harness — post-mission email notification (uses Resend; falls back to first ADMIN_EMAILS)
# HARNESS_NOTIFY_EMAIL=you@example.com

# Optional read-only Postgres URL for harness snapshot intelligence (overrides DATABASE_URL)
# HARNESS_DATABASE_URL=postgresql://postgres.YOUR_PROJECT_REF:YOUR_PASSWORD@aws-0-REGION.pooler.supabase.com:6543/postgres

# When set, forcing newsletter regen (GET /api/newsletter/edition?refresh=true or POST
# /api/newsletter/generate) requires header X-Newsletter-Regen-Key: <this value>, or an admin JWT.
# Leave unset for local dev (regen stays open).
# NEWSLETTER_REGEN_SECRET=long-random-string

# Static Next export: set at build time so the browser calls your API host
# NEXT_PUBLIC_API_URL=https://your-api.example.com
# NEXT_PUBLIC_SITE_URL=https://your-site.example.com

# FastAPI CORS — comma-separated; required when the static site and API are on different hosts
# (wildcard + credentials is invalid in browsers). Defaults are set in app/main.py if unset.
# CORS_ORIGINS=https://readyforrobots.com,https://ready-2-robot.fly.dev

# Optional: stricter company-name validation for scraped leads (calls wikidata.org for
# long headline-like strings only). Default off — set to 1 in production if desired.
# COMPANY_NAME_WIKIDATA_VERIFY=1

# Optional: infer brand.com / www.brand.com from the first non-generic token and check
# DNS (and HTTPS). Same long-name trigger as Wikidata. Strict reject is off by default.
# COMPANY_NAME_DNS_HTTPS_VERIFY=1
# COMPANY_NAME_DNS_HTTPS_STRICT=1

# Outreach email sending (Resend)
# RESEND_API_KEY=re_xxxxxxxxxxxxxxxxx
# RESEND_FROM_EMAIL=Ready For Robots <outreach@yourdomain.com>
# Optional fallback when a specific SCOUT reply token is not supplied.
# RESEND_REPLY_TO=hello@yourdomain.com
# Required for inbound reply capture from Resend webhooks.
# RESEND_WEBHOOK_SECRET=whsec_xxxxxxxxxxxxxxxxx
# Optional inbound reply domain. Defaults to the domain in RESEND_FROM_EMAIL.
# SCOUT_REPLY_DOMAIN=readyforrobots.com
# Optional local part for reply tokens: reply+<token>@SCOUT_REPLY_DOMAIN
# SCOUT_REPLY_LOCAL_PART=reply

# Prospect search (Apollo.io)
# APOLLO_API_KEY=your_apollo_api_key

# LinkedIn — Ready For Robots company page id 114404417
# Products available now: "Share on LinkedIn" + "Sign In with LinkedIn (OpenID Connect)"
# LINKEDIN_POST_MODE=member  (default) — posts to the authorizing admin's personal feed
# LINKEDIN_POST_MODE=organization — requires Marketing API / w_organization_social approval
# LINKEDIN_CLIENT_ID=
# LINKEDIN_CLIENT_SECRET=
# LINKEDIN_ORGANIZATION_ID=114404417
# LINKEDIN_REDIRECT_URI=https://ready-2-robot.fly.dev/api/linkedin/callback
# LINKEDIN_API_VERSION=202505
# Optional bootstrap without OAuth UI (expires ~60 days):
# LINKEDIN_ACCESS_TOKEN=
# LINKEDIN_REFRESH_TOKEN=
# Content Studio connect/publish uses X-Admin-Key header (must match Fly secret ADMIN_KEY)
# ADMIN_KEY=long-random-string

# HubSpot OAuth — /integrations/hubspot (HubSpot CLI projects framework)
# 1) npm install -g @hubspot/cli@latest && hs account auth
# 2) cd integrations/hubspot-scout-app && hs project upload && hs project open
# 3) Auth tab → copy Client ID + secret → fly secrets set (see integrations/hubspot-scout-app/README.md)
# HUBSPOT_CLIENT_ID=
# HUBSPOT_CLIENT_SECRET=
# HUBSPOT_REDIRECT_URI=https://ready-2-robot.fly.dev/api/integrations/hubspot/callback
# PUBLIC_SITE_URL=https://readyforrobots.com

# Add any additional environment variables as needed