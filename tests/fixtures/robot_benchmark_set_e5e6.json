      "expected_buyer_verticals": ["hospitals", "health_systems"],
      "must_not_match": ["construction", "agriculture"],
      "language_traps": ["clinical team support", "nursing workflow", "frees up nurses"],
      "notes": "Baseline: already passes per the agent. Use as regression check."
