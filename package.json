{
  "name": "ready-for-robots",
  "private": true,
  "description": "Root scripts delegate to frontend/nextjs — run npm install in frontend/nextjs first (or use npm run install:web).",
  "scripts": {
    "install:web": "npm install --prefix frontend/nextjs",
    "dev": "npm run dev --prefix frontend/nextjs",
    "build": "npm run build --prefix frontend/nextjs",
    "start": "npm run start --prefix frontend/nextjs",
    "lint": "npm run lint --prefix frontend/nextjs",
    "validate": "npm run lint --prefix frontend/nextjs",
    "deploy:fly": "flyctl deploy"
  },
  "dependencies": {
    "@supabase/ssr": "^0.10.2",
    "@supabase/supabase-js": "^2.103.3"
  }
}
