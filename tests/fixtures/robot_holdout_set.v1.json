{
  "name": "RFR robot classification HOLD-OUT set",
  "version": "holdout-v1",
  "date": "2026-10-13",
  "taxonomy": "taxonomy.v1.json (v1.1)",
  "purpose": "Fresh robots never used for prompt or rule changes. Measures real-world accuracy of the extractor after the rule changes (primary function, buyer-industry definition, unsupported-fact exclusion).",
  "rules_for_use": [
    "1. Snapshot all pages (use --render where blocked). Commit snapshots BEFORE running anything.",
    "2. Score with the SAME frozen scorer and rules as robot_benchmark_set.v2.json. No scorer, prompt, or answer-key changes based on these results.",
    "3. Run once with product hint and once without. Report both.",
    "4. Report robots, taxonomy gap probes, and negative controls as three separate results. Never one blended percentage.",
    "5. If any URL is wrong or dead, report it; do not substitute another company.",
    "6. Industry = the industry of the organization that buys and operates the robot, not the building or project type."
  ],
