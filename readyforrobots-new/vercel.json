{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "framework": null,
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile",
  "buildCommand": "VITE_PUBLIC_API_URL= npx --yes pnpm@10.4.1 exec vite build",
  "outputDirectory": "dist/public",
  "ignoreCommand": "[ \"$VERCEL_ENV\" != \"production\" ] || case \"$VERCEL_GIT_COMMIT_REF\" in cursor/*) true;; *) false;; esac",
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "https://ready-2-robot.fly.dev/api/:path*"
    },
    {
      "source": "/health/:path*",
      "destination": "https://ready-2-robot.fly.dev/health/:path*"
    },
    {
      "source": "/health",
      "destination": "https://ready-2-robot.fly.dev/health"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ]
}
