{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "installCommand": "npx --yes pnpm@10.4.1 install --frozen-lockfile -C readyforrobots-new",
  "buildCommand": "cd readyforrobots-new && npx --yes pnpm@10.4.1 exec vite build",
  "outputDirectory": "readyforrobots-new/dist/public",
  "rewrites": [{ "source": "/(.*)", "destination": "/index.html" }]
}
